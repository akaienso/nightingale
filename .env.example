# ============================================================================
# Nightingale — Environment Variables (template)
# ----------------------------------------------------------------------------
# Copy this file to ".env" and fill in real values for local development:
#   cp .env.example .env
# NEVER commit your real .env — it contains secrets.
# ============================================================================

# --- Database (REQUIRED) ---------------------------------------------------
# PostgreSQL connection string used by Prisma.
# Local example (with a local Postgres): 
#   postgresql://USER:PASSWORD@localhost:5432/nightingale?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/nightingale?schema=public"

# --- Authentication (REQUIRED) ---------------------------------------------
# Secret used to sign session tokens. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Base URL of the app in your environment.
NEXTAUTH_URL="http://localhost:3000"

# --- AI translation & chat (OPTIONAL) --------------------------------------
# The translate/chat API routes call a hosted model API through lib/anthropic.ts.
# Without a valid key these specific AI features will not return results, but the
# rest of the app (UI, auth, history, settings) still runs.
ABACUSAI_API_KEY=""
# Alternatively, if you wire the routes to Anthropic directly:
ANTHROPIC_API_KEY=""

# --- Google Sign-In (OPTIONAL) ---------------------------------------------
# Only needed if you want the "Continue with Google" flow locally.
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Cloud storage for uploads (OPTIONAL) ----------------------------------
# Used by the image-translate / upload features. S3-compatible storage.
AWS_REGION=""
AWS_BUCKET_NAME=""
AWS_FOLDER_PREFIX=""

# --- Bot / spam protection (OPTIONAL) --------------------------------------
# Cloudflare Turnstile keys for the contact / inquiry forms.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Analytics (OPTIONAL) --------------------------------------------------
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=""

# --- Email notifications (OPTIONAL) ----------------------------------------
# Notification type IDs used by the contact / tutoring inquiry routes.
NOTIF_ID_WEBSITE_INQUIRY=""
NOTIF_ID_TUTORING_INQUIRY=""
