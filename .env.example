# ============================================================================
# Nightingale — Environment Variables (template)
# ----------------------------------------------------------------------------
# Copy this file to ".env" and fill in real values for local development:
#   cp .env.example .env
# NEVER commit your real .env — it contains secrets.
#
# This file is kept in sync with what the code actually reads. If you add a
# `process.env.X` anywhere, add X here too.
# ============================================================================

# --- Database (REQUIRED) ---------------------------------------------------
# PostgreSQL connection string used by Prisma.
# Local example (with a local Postgres):
#   postgresql://USER:PASSWORD@localhost:5432/nightingale?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/nightingale?schema=public"

# --- Authentication (REQUIRED) ---------------------------------------------
# Secret used to sign session tokens. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Base URL of the app in your environment. Also used as `metadataBase`.
NEXTAUTH_URL="http://localhost:3000"

# --- AI translation & chat (OPTIONAL) --------------------------------------
# The translate / translate-image / chat routes call the Anthropic Messages API
# directly through lib/anthropic.ts. Without a key those features return errors;
# the rest of the app (UI, auth, history, settings) still runs.
ANTHROPIC_API_KEY=""

# --- Google Sign-In (OPTIONAL) ---------------------------------------------
# Only needed if you want the "Continue with Google" flow locally.
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Object storage: Cloudflare R2 (OPTIONAL) ------------------------------
# Used by the image-translate upload flow and report screenshots. R2 speaks the
# S3 API. See docs/r2-setup.md for creating the bucket and a scoped API token.
# Falls back to CF_ACCOUNT_ID when unset.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Optional key prefix inside the bucket (e.g. "nightingale/"). Usually empty.
R2_FOLDER_PREFIX=""
# Public hostname for unsigned reads — the bucket's r2.dev URL or a bound custom
# domain. No trailing slash. NOT interchangeable with the S3 endpoint: presigned
# URLs only work on <account>.r2.cloudflarestorage.com, never a custom domain.
R2_PUBLIC_BASE_URL=""

# --- Transactional email: Cloudflare Email Sending (OPTIONAL) --------------
# Powers the contact, tutoring-inquiry and content-report forms. Without these
# the forms return 502 — there is deliberately no silent-success mute switch.
CF_ACCOUNT_ID=""
# API token with email sending permission. Distinct from the R2 S3 credentials.
CF_EMAIL_API_TOKEN=""
# Domain used for the sender and for default recipient mailboxes. Must be the
# domain onboarded to Email Sending (the apex, not the app subdomain).
MAIL_DOMAIN="nightingale.im"
# Sender address and display name. Default: noreply@$MAIL_DOMAIN.
MAIL_FROM=""
MAIL_FROM_NAME="Nightingale"
# Per-form recipient overrides. Each defaults to <mailbox>@$MAIL_DOMAIN, so
# changing MAIL_DOMAIN is normally all that is needed.
CONTACT_RECIPIENT_EMAIL=""     # default hello@$MAIL_DOMAIN
TUTORING_RECIPIENT_EMAIL=""    # default olia@$MAIL_DOMAIN
REPORT_RECIPIENT_EMAIL=""      # default reports@$MAIL_DOMAIN

# --- Bot / spam protection (OPTIONAL) --------------------------------------
# Cloudflare Turnstile, verified on login and signup.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Analytics (OPTIONAL) --------------------------------------------------
# Cloudflare Web Analytics beacon token. Only injected in production, and
# ignored when set to the literal "placeholder".
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=""

# --- Rate limits (OPTIONAL) ------------------------------------------------
# All have safe defaults in lib/rate-limit.ts; set only to override.
GUEST_TRANSLATE_PER_HOUR="30"
GUEST_TRANSLATE_PER_DAY="150"
USER_TRANSLATE_PER_DAY="600"
USER_IMAGE_PER_DAY="100"
USER_CHAT_PER_DAY="400"
# Content-report submissions per IP (defaults 10/hour, 40/day).
REPORT_PER_HOUR="10"
REPORT_PER_DAY="40"

# --- Build (OPTIONAL) ------------------------------------------------------
# Read by next.config.js. Leave unset for normal builds.
NEXT_DIST_DIR=""
NEXT_OUTPUT_MODE=""
